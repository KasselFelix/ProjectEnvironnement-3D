# Sortie de compilation
bin/

# Sortie de compilation des tests et fat-jar JUnit (téléchargé via test-setup.sh)
test/bin/

# Crash dumps JVM
hs_err_pid*.log
core.*
replay_pid*.log

# Ignore all Eclipse settings
.settings/

# But keep Java compiler settings
!.settings/org.eclipse.jdt.core.prefs

# And keep encoding settings
!.settings/org.eclipse.core.resources.prefs

# IDE locaux — on commit les configs partagées (tasks/launch/extensions),
# on ignore le reste (settings utilisateur, cache, etc.)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# macOS
.DS_Store

# Linux
*~

# Backups éventuels
*.bak
JOGL-*-backup/

# Captures d'écran générées en jeu (F12)
screenshots/

# Réglages utilisateur (bindings, hotbar, prefs UI) — local, non partagé
settings.properties
